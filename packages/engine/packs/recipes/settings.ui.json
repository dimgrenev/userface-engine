{
  "schema": "face",
  "schema-version": 1,
  "meta": {
    "id": "recipe/settings",
    "name": "Settings Page",
    "description": "User/app settings page with sections, toggles, and save action",
    "tags": [
      "b2b",
      "settings",
      "preferences"
    ]
  },
  "root": {
    "type": "Card",
    "props": {
      "title": "Settings"
    },
    "children": [
      {
        "type": "Card",
        "key": "profile-section",
        "props": {
          "title": "Profile"
        },
        "children": [
          {
            "type": "Input",
            "key": "name",
            "props": {
              "label": "Display Name",
              "value": {
                "$ref": "settings.displayName"
              },
              "onValueChange": {
                "$action": "settings.update"
              }
            }
          },
          {
            "type": "Input",
            "key": "email",
            "props": {
              "label": "Email",
              "type": "email",
              "value": {
                "$ref": "settings.email"
              },
              "onValueChange": {
                "$action": "settings.update"
              }
            }
          }
        ]
      },
      {
        "type": "Card",
        "key": "preferences-section",
        "props": {
          "title": "Preferences"
        },
        "children": [
          {
            "type": "Switcher",
            "key": "dark-mode",
            "props": {
              "label": "Dark Mode",
              "checked": {
                "$ref": "settings.darkMode"
              },
              "onCheckedChange": {
                "$action": "settings.toggleDarkMode"
              }
            }
          },
          {
            "type": "Switcher",
            "key": "notifications",
            "props": {
              "label": "Email Notifications",
              "checked": {
                "$ref": "settings.emailNotifications"
              },
              "onCheckedChange": {
                "$action": "settings.toggleNotifications"
              }
            }
          },
          {
            "type": "Select",
            "key": "language",
            "props": {
              "label": "Language",
              "items": {
                "$ref": "settings.languageOptions"
              },
              "value": {
                "$ref": "settings.language"
              },
              "onValueChange": {
                "$action": "settings.updateLanguage"
              }
            }
          }
        ]
      },
      {
        "type": "Bar",
        "key": "actions",
        "children": [
          {
            "type": "Button",
            "key": "save",
            "props": {
              "type": "submit",
              "variant": "accent",
              "onClick": {
                "$action": "settings.save"
              },
              "children": "Save Changes"
            }
          }
        ]
      }
    ]
  }
}
