{
  "schema": "face",
  "schema-version": 1,
  "meta": {
    "id": "recipe/dashboard",
    "name": "Admin Dashboard",
    "description": "B2B admin dashboard with tab navigation, stats cards, and data table",
    "tags": [
      "b2b",
      "admin",
      "dashboard"
    ]
  },
  "root": {
    "type": "Card",
    "props": {
      "title": "Dashboard"
    },
    "children": [
      {
        "type": "Tabs",
        "key": "nav",
        "props": {
          "items": [
            {
              "value": "overview",
              "label": "Overview"
            },
            {
              "value": "users",
              "label": "Users"
            },
            {
              "value": "settings",
              "label": "Settings"
            }
          ],
          "value": {
            "$ref": "nav.activeTab"
          }
        }
      },
      {
        "type": "Card",
        "key": "stats",
        "props": {
          "title": "Key Metrics"
        },
        "children": [
          {
            "type": "Text",
            "key": "metric-users",
            "props": {
              "children": {
                "$ref": "stats.totalUsers"
              }
            }
          },
          {
            "type": "Text",
            "key": "metric-revenue",
            "props": {
              "children": {
                "$ref": "stats.revenue"
              }
            }
          },
          {
            "type": "Progress",
            "key": "metric-progress",
            "props": {
              "value": {
                "$ref": "stats.goalProgress"
              },
              "label": "Goal Progress"
            }
          }
        ]
      },
      {
        "type": "Table",
        "key": "data-table",
        "props": {
          "columns": {
            "$ref": "table.columns"
          },
          "rows": {
            "$ref": "table.rows"
          }
        }
      }
    ]
  }
}
