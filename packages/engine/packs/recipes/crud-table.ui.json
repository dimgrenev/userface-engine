{
  "schema": "face",
  "schema-version": 1,
  "meta": {
    "id": "recipe/crud-table",
    "name": "CRUD Table",
    "description": "Data table with search, create/edit modal, and row actions",
    "tags": [
      "b2b",
      "crud",
      "table",
      "data"
    ]
  },
  "root": {
    "type": "Card",
    "props": {
      "title": {
        "$ref": "page.title"
      }
    },
    "children": [
      {
        "type": "Bar",
        "key": "toolbar",
        "children": [
          {
            "type": "Input",
            "key": "search",
            "props": {
              "label": "Search",
              "placeholder": "Search...",
              "value": {
                "$ref": "search.query"
              },
              "onValueChange": {
                "$action": "search.update"
              }
            }
          },
          {
            "type": "Button",
            "key": "create-btn",
            "props": {
              "variant": "accent",
              "onClick": {
                "$action": "modal.openCreate"
              },
              "children": "Create New"
            }
          }
        ]
      },
      {
        "type": "Table",
        "key": "data-table",
        "props": {
          "columns": {
            "$ref": "table.columns"
          },
          "rows": {
            "$ref": "table.filteredRows"
          }
        }
      },
      {
        "type": "Modal",
        "key": "edit-modal",
        "props": {
          "open": {
            "$ref": "modal.isOpen"
          },
          "title": {
            "$ref": "modal.title"
          },
          "onOpenChange": {
            "$action": "modal.close"
          }
        },
        "children": [
          {
            "type": "Input",
            "key": "field-name",
            "props": {
              "label": "Name",
              "value": {
                "$ref": "modal.form.name"
              },
              "onValueChange": {
                "$action": "form.updateName"
              }
            }
          },
          {
            "type": "Input",
            "key": "field-email",
            "props": {
              "label": "Email",
              "value": {
                "$ref": "modal.form.email"
              },
              "onValueChange": {
                "$action": "form.updateEmail"
              }
            }
          },
          {
            "type": "Button",
            "key": "save-btn",
            "props": {
              "type": "submit",
              "onClick": {
                "$action": "form.submit"
              },
              "children": "Save"
            }
          },
          {
            "type": "Button",
            "key": "cancel-btn",
            "props": {
              "variant": "outline",
              "onClick": {
                "$action": "modal.close"
              },
              "children": "Cancel"
            }
          }
        ]
      }
    ]
  }
}
